# Production Environment Variables
# Database Configuration
DATABASE_URL=postgresql://mindmate:CHANGE_THIS_PASSWORD@localhost:5432/mindmate_db
USE_SQLITE=false

# Security - CHANGE THESE IN PRODUCTION
SECRET_KEY=GENERATE_A_SECURE_32_CHARACTER_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI API - Use your existing key
OPENAI_API_KEY=your-production-openai-api-key

# Redis (optional)
REDIS_URL=redis://localhost:6379

# CORS Origins - Update with your production URLs
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Risk Assessment Thresholds
HIGH_RISK_THRESHOLD=0.7
MEDIUM_RISK_THRESHOLD=0.4

# Production specific
ENVIRONMENT=production
DEBUG=false